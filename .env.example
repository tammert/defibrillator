# defibrillator + hermes-agent — required for `docker compose up`
# Copy this file to .env and fill in real values. .env is git-ignored.

# NIC MAC of the 5090 — `ip link show` on the 5090.
WOL_MAC=AA:BB:CC:DD:EE:FF

# 32+ char auth key for the hermes OpenAI-compatible API server (:8642).
#   openssl rand -hex 32
HERMES_API_KEY=

# --- optional (defaults shown) ---

# 5090 LAN IP, reached by the proxy.  Default: 192.168.1.90
# OLLAMA_LAN_IP=
# SSH user@ip the proxy calls poweroff on.  Default: tammert@192.168.1.90
# Leave SSH_TARGET empty to have wake-only, no idle poweroff.
# SSH_TARGET=
# POWEROFF_CMD default is "systemctl poweroff"; on boxes without polkit use
# POWEROFF_CMD="sudo systemctl poweroff" + a matching sudoers line.
# POWEROFF_CMD=
