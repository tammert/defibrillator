# .dockerignore for defibrillator
# build needs: Dockerfile, go.mod, main.go — everything else is noise.
# (Docker's ignore has no allowlist "block", so we enumerate what to drop.)

# tests + docs + license
test.sh
README.md
LICENSE
docker-compose.yml

# git + editors
.git/
.gitignore
.idea/
.vscode/
.env

# build/test scratch
bin/
defibrillator
*.log
*.txt
*.pid
*.codes
*.exe
*.test
*.out
*.coverprofile
vendor/
go.work
go.work.sum
proxy.log
plog.txt
ssh.log
run.log
sniff.txt
sniff.log
body.txt
hdr.txt
D.codes
proxy.pid
fake.pid
sniff.pid
